{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jackpotmc-staff-panel",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-11-02",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/internal/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "STAFF_PANEL_BRIDGE",
				"class_name": "StaffPanelBridge"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"StaffPanelBridge"
			]
		}
	]
}
